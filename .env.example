# MongoDB Connection String (get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bkgroup?retryWrites=true&w=majority

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Owner details (optional)
OWNER_EMAIL=owner@example.com

# Admin security keys
ADMIN_KEY=your-admin-key
OWNER_KEY=your-owner-key

# Port (leave blank for production, Render assigns automatically)
PORT=3000
